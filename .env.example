# football-data.org free key. Optional: fixtures and scores also come from FPL.
FOOTBALL_DATA_API_KEY=
# Where the DuckDB file, snapshots and model artifacts live.
# Keep this out of OneDrive/Dropbox: sync clients lock DuckDB files.
PITCHSIDE_DATA_DIR=./data
# Required for /api/v1/admin/* routes. Empty disables them.
ADMIN_TOKEN=
SCHEDULER_ENABLED=true
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
# Refresh intervals, hours.
REFRESH_FPL_HOURS=3
REFRESH_FPL_HISTORY_HOURS=168
REFRESH_FOOTBALL_DATA_ORG_HOURS=6
REFRESH_FOOTBALL_DATA_UK_HOURS=24
REFRESH_TRANSFERMARKT_HOURS=168
REFRESH_UNDERSTAT_HOURS=24
PREDICTIONS_REFRESH_HOURS=6
MODEL_RETRAIN_HOURS=168
